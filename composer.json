{
  "name": "thathoff/kirby-git-content",
  "description": "Plugin to track changes to content in a git repository.",
  "type": "kirby-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Markus Denhoff",
      "email": "markus@denhoff.com"
    },
    {
      "name": "reinorange GmbH",
      "email": "info@reinorange.com"
    }
  ],
  "support": {
    "issues": "https://github.com/thathoff/kirby-git-content/issues",
    "source": "https://github.com/thathoff/kirby-git-content"
  },
  "require": {
    "czproject/git-php": "^4.4.0",
    "getkirby/composer-installer": "^1.2",
    "php": ">=8.3"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.10",
    "phpstan/phpstan": "^2.0",
    "getkirby/cms": "^6.0"
  },
  "scripts": {
    "phpstan": "phpstan analyse",
    "phpcs": "phpcs",
    "phpcbf": "phpcbf"
  },
  "autoload": {
    "psr-4": {
      "Thathoff\\GitContent\\": "src/"
    }
  },
  "extra": {
    "installer-name": "git-content",
    "kirby-cms-path": false,
    "kirby": {
      "compatible": "^6.0"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  }
}
